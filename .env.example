APP_NAME=Luxio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Prague

APP_LOCALE=cs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Aplikace neposílá žádné e-maily (upozornění chodí jen jako push na telefon).
MAIL_MAILER=log

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Web Push (klíče vygeneruje: php artisan webpush:vapid). VAPID_SUBJECT je kontakt na
# provozovatele pro služby Apple/Google, které upozornění doručují – e-mail se na něj neposílá.
VAPID_SUBJECT=mailto:info@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Ostrý provoz: APP_ENV=production, APP_DEBUG=false, APP_URL=https://…,
# SESSION_SECURE_COOKIE=true. Fronta přes plánovač (cron každou minutu):
QUEUE_VIA_SCHEDULER=true

# Běh v podsložce webu (např. https://example.com/luxio): APP_URL včetně podsložky
# a SESSION_PATH=/luxio, aby cookies nechodily zbytku webu.

# Sdílená databáze na hostingu: tabulky s předponou, ať se nepletou s jinou aplikací.
# DB_PREFIX=luxio_

# Hosting bez příkazové řádky (viz README – Nasazení bez SSH): tajné klíče adres
# /instalace/{klíč} a /cron/{klíč}; prázdné = adresy neexistují.
LUXIO_SETUP_KEY=
LUXIO_CRON_KEY=
# REMINDER_WINDOW_MINUTES=10

# Web za proxy nebo CDN (limity podle IP adresy): * nebo seznam adres.
# TRUSTED_PROXIES=*
